# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Database Connection String (Direct or Transaction Pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# AI Configuration
# Supported providers: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenAI API (Optional if using Gemini)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Dimensions: 768 for Gemini gemini-embedding-2, 1536 for OpenAI text-embedding-3-small
VECTOR_DIMENSION=768

# RAG Hyperparameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
